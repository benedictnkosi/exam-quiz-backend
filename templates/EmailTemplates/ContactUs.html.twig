<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>New Contact Form Submission</title>
  </head>
  <body style="background-color: #f4f6f8; margin: 0; padding: 0; font-family: 'Segoe UI', Arial, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f6f8; padding: 40px 0;">
      <tr>
        <td align="center">
          <table width="480" cellpadding="0" cellspacing="0" style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.07); padding: 32px 32px 24px 32px;">
            <tr>
              <td align="center" style="padding-bottom: 16px;">
                <img src="https://cdn-icons-png.flaticon.com/512/3059/3059993.png" alt="Contact Icon" width="64" height="64" style="display: block; margin-bottom: 12px;"/>
                <h2 style="color: #2d3748; margin: 0 0 8px 0; font-size: 26px; font-weight: 700;">New Contact Form Submission</h2>
              </td>
            </tr>
            <tr>
              <td style="color: #4a5568; font-size: 16px; padding-bottom: 18px;">
                <p style="margin: 0 0 18px 0;">A new contact form has been submitted with the following details:</p>
                <table width="100%" cellpadding="0" cellspacing="0" style="background: #f7fafc; border-radius: 6px; margin-bottom: 18px;">
                  <tr><td style="padding: 8px 16px;"><strong>First Name:</strong> {{ first_name }}</td></tr>
                  <tr><td style="padding: 8px 16px;"><strong>Last Name:</strong> {{ last_name }}</td></tr>
                  <tr><td style="padding: 8px 16px;"><strong>Email:</strong> {{ email }}</td></tr>
                  <tr><td style="padding: 8px 16px;"><strong>Phone:</strong> {{ phone }}</td></tr>
                  {% if service_interested is defined and service_interested %}
                  <tr><td style="padding: 8px 16px;"><strong>Service Interested:</strong> {{ service_interested }}</td></tr>
                  {% endif %}
                  {% if grade is defined and grade %}
                  <tr><td style="padding: 8px 16px;"><strong>Grade:</strong> {{ grade }}</td></tr>
                  {% endif %}
                  {% if child_name is defined and child_name %}
                  <tr><td style="padding: 8px 16px;"><strong>Child Name:</strong> {{ child_name }}</td></tr>
                  {% endif %}
                </table>
                <h3 style="color: #2d3748; margin: 0 0 12px 0; font-size: 18px; font-weight: 600;">Message:</h3>
                <div style="background: #f7fafc; border-radius: 6px; padding: 16px; margin-bottom: 18px; border-left: 4px solid #3182ce;">
                  <p style="margin: 0; color: #4a5568; font-size: 15px; line-height: 1.6;">{{ message }}</p>
                </div>
                <div style="text-align: center; margin: 24px 0 0 0;">
                  <p style="color: #a0aec0; font-size: 13px;">Please respond to this inquiry as soon as possible.</p>
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding-top: 24px; color: #a0aec0; font-size: 13px; text-align: center;">
                <p style="margin: 0;">Thank you for using our platform.<br/>— The Team</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html> 