<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>New Appointment Booking</title>
  </head>
  <body style="background-color: #f4f6f8; margin: 0; padding: 0; font-family: 'Segoe UI', Arial, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f6f8; padding: 40px 0;">
      <tr>
        <td align="center">
          <table width="480" cellpadding="0" cellspacing="0" style="background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.07); padding: 32px 32px 24px 32px;">
            <tr>
              <td align="center" style="padding-bottom: 16px;">
                <img src="https://cdn-icons-png.flaticon.com/512/2921/2921222.png" alt="Appointment Icon" width="64" height="64" style="display: block; margin-bottom: 12px;"/>
                <h2 style="color: #d53f8c; margin: 0 0 8px 0; font-size: 26px; font-weight: 700;">New Appointment Booking</h2>
              </td>
            </tr>
            <tr>
              <td style="color: #4a5568; font-size: 16px; padding-bottom: 18px;">
                <p style="margin: 0 0 18px 0;">A new appointment has been requested with the following details:</p>
                <table width="100%" cellpadding="0" cellspacing="0" style="background: #f7fafc; border-radius: 6px; margin-bottom: 18px;">
                  {% if branch is defined and branch %}
                  <tr><td style="padding: 8px 16px;"><strong>Branch:</strong> {{ branch }}</td></tr>
                  {% endif %}
                  <tr><td style="padding: 8px 16px;"><strong>Service:</strong> {{ service }}</td></tr>
                  <tr><td style="padding: 8px 16px;"><strong>Date:</strong> {{ date }}</td></tr>
                  {% if time is defined and time %}
                  <tr><td style="padding: 8px 16px;"><strong>Time:</strong> {{ time }}</td></tr>
                  {% endif %}
                  <tr><td style="padding: 8px 16px;"><strong>Full Name:</strong> {{ full_name }}</td></tr>
                  <tr><td style="padding: 8px 16px;"><strong>Phone Number:</strong> {{ phone_number }}</td></tr>
                  {% if notes is defined and notes %}
                  <tr><td style="padding: 8px 16px;"><strong>Additional Notes:</strong> {{ notes }}</td></tr>
                  {% endif %}
                </table>
                <div style="text-align: center; margin: 24px 0 0 0;">
                  <p style="color: #a0aec0; font-size: 13px;">Please contact the customer to confirm the booking.</p>
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding-top: 24px; color: #a0aec0; font-size: 13px; text-align: center;">
                <p style="margin: 0;">Thank you for using our platform.<br/>— The Team</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html> 